{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Android ARM64 Release",
      "description": "Build clipsyncd with the Android NDK from ANDROID_NDK_HOME.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "debug",
      "displayName": "Android ARM64 Debug",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/android-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" }
  ]
}
